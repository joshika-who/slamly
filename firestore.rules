rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: checks if the requester is signed in via Firebase Authentication
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper: checks if the signed-in user owns the parent book document
    function isBookOwner(bookId) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/books/$(bookId))
        && get(/databases/$(database)/documents/books/$(bookId)).data.ownerId == request.auth.uid;
    }

    // Helper: validates book document fields on create and update
    function isValidBookData(data) {
      return data.title is string
        && data.title.trim().size() >= 1
        && data.title.size() <= 100
        && data.description is string
        && data.description.size() <= 500
        && data.coverTheme is string
        && data.coverTheme in ['pink', 'lavender', 'peach', 'sage']
        && data.status is string
        && data.status in ['draft', 'published', 'closed']
        && (data.templateId == null || data.templateId is string)
        && data.questions is list
        && data.questions.size() <= 50;
    }

    // Helper: validates a friend response submission on CREATE
    // Note: Firestore Rules cannot loop over dynamic list items, so per-answer character
    // limits (1000 chars) are enforced in the client, with Firestore's 1 MiB document size
    // limit acting as the hard server cap.
    function isValidResponseData(data) {
      return data.keys().hasOnly(['respondentName', 'answers', 'createdAt'])
        && data.keys().hasAll(['respondentName', 'answers', 'createdAt'])
        && data.respondentName is string
        && data.respondentName.trim().size() >= 1
        && data.respondentName.size() <= 50
        && data.answers is list
        && data.answers.size() <= 50
        && data.createdAt == request.time;
    }

    // Helper: validates an owner edit to an existing response on UPDATE
    // Ensures keys remain strictly respondentName, answers, and createdAt,
    // and that createdAt is never modified.
    function isValidResponseUpdate(newData, existingData) {
      return newData.keys().hasOnly(['respondentName', 'answers', 'createdAt'])
        && newData.keys().hasAll(['respondentName', 'answers', 'createdAt'])
        && newData.createdAt == existingData.createdAt
        && newData.respondentName is string
        && newData.respondentName.trim().size() >= 1
        && newData.respondentName.size() <= 50
        && newData.answers is list
        && newData.answers.size() <= 50;
    }

    // Top-level books collection
    match /books/{bookId} {
      // Single-document read (get): allowed for the book owner OR anyone if the book is "published" or "closed"
      allow get: if (isSignedIn() && resource.data.ownerId == request.auth.uid)
        || resource.data.status in ['published', 'closed'];

      // Collection queries (list): ONLY allowed for the authenticated owner of those books.
      // Public list queries are never allowed so published books cannot be browsed or enumerated.
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      // Create: user must be signed in, set ownerId to their own UID, and pass validation
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidBookData(request.resource.data);

      // Update: only the owner can update, ownerId & createdAt must never change, and fields must be valid
      allow update: if isSignedIn()
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidBookData(request.resource.data);

      // Delete: only the owner can delete their own book
      allow delete: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;

      // Subcollection: friend responses for a specific slam book
      match /responses/{responseId} {
        // Create: allowed for anyone (signed in or not) ONLY if the parent book exists
        // and its status is currently "published", and the response payload is valid.
        allow create: if exists(/databases/$(database)/documents/books/$(bookId))
          && get(/databases/$(database)/documents/books/$(bookId)).data.status == 'published'
          && isValidResponseData(request.resource.data);

        // Read & Delete: restricted strictly to the parent book's owner
        allow read, delete: if isBookOwner(bookId);

        // Update: allowed ONLY for the parent book's owner, preserving createdAt and valid fields
        allow update: if isBookOwner(bookId)
          && isValidResponseUpdate(request.resource.data, resource.data);
      }
    }

    // Default deny for everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
