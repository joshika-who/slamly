# Slamly — Firebase Web App Configuration (Milestone 2)
# Copy this file to .env.local and paste your values from:
# Firebase Console -> Project Settings -> General -> Your apps -> Web app

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Slamly — Firebase App Check Configuration (Milestone 7)
# Public reCAPTCHA v3 (or Enterprise) site key registered in Firebase Console -> Build -> App Check
VITE_RECAPTCHA_SITE_KEY=
# Optional: set to "enterprise" if using a reCAPTCHA Enterprise key (defaults to "v3")
VITE_RECAPTCHA_PROVIDER=
# Optional: local development debug token (used ONLY in `npm run dev`, ignored in production builds)
VITE_APPCHECK_DEBUG_TOKEN=

